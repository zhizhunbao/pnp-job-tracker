#!/bin/sh
# push 前自动过 eslint(Frank 2026-08-21 拍板:「git push 之前先要过一遍 eslint,自动触发的」)。
#
# · 只查本次要推的 cms 内 .ts/.tsx/.mjs 改动 —— 全量 eslint 要几分钟,hook 里等不起;
# · --quiet = 只有 error 拦 push;warning(如 no-inline-coercion 的整改清单)不拦;
# · 🔴 禁 --no-verify 绕过(CLAUDE.md 站规):报错就修,修不了先别推。
#
# 生效需要一次性设置(每个 clone 一次):git config core.hooksPath .githooks

# (frontend) 文件清单闸(2026-08-29 Frank「frontend 能包含哪些文件能不能锁死了」+「加到闸门」
# +「没用到的都排除」):eslint 的 route-file-names 只圈得住 .ts/.tsx,css/图片等杂物它看不见 ——
# 这里按**任意后缀**全目录点名。白名单只列**现役三名**(page/layout 两框架名 + main.css 全站样式
# 入口唯一钦定特例);sitemap.ts 与 opengraph-image.tsx 分别随 08-29/08-30 归目录批退役(app/sitemaps 与 app/og
# 一个动态壳);loading/error/not-found/icon 等框架名现在没用到,一律不预开 ——
# 哪天真要用,加名先过 Frank。
FRONTEND_ALLOW='^(page\.tsx|layout\.tsx|main\.css)$'
strays=$(cd cms/src/app/'(frontend)' 2>/dev/null && find . -type f | sed 's|.*/||' | grep -Ev "$FRONTEND_ALLOW" | sort -u)
if [ -n "$strays" ]; then
  echo "[pre-push] (frontend) 里有清单外文件,push 已拦:"
  echo "$strays" | sed 's/^/  - /'
  echo "[pre-push] 路由树只住框架定名文件;视觉件归 components/<页面域>/,杂物别放这。"
  exit 1
fi

upstream=$(git rev-parse --abbrev-ref '@{push}' 2>/dev/null || echo origin/main)

# etl 写法闸(2026-08-29 分域批3):改动了 etl 的 .py 才跑 —— ruff(严打族全局开,
# 存量按域挂 per-file-ignores,pyproject 里一域一行)+ 形制自查役(域间 import 零容忍、
# IN/OUT 常量、一域一门 __main__、域文件名五件套白名单,
# 存量走 etl/gate/etl_shape_baseline.json 只紧不松)。
etl_changed=$(git diff --name-only --diff-filter=d "$upstream"..HEAD 2>/dev/null | grep -E '^etl/.*\.py$')
if [ -n "$etl_changed" ]; then
  echo "[pre-push] etl 改动 $(echo "$etl_changed" | wc -l) 个 py,过 ruff + 形制闸…"
  uv run --with ruff ruff check etl || { echo "[pre-push] ruff 有 error,push 已拦。"; exit 1; }
  # 2026-08-31 批D:ops 拆散,形制闸迁根改名 etl/check_shape.py(基线同迁 etl/etl_shape_baseline.json)
  # 2026-08-31 批K:根上五件管理层脚本全溶 gate/sched 两域,形制闸成 gate 域的一步
  # (基线同迁 etl/gate/etl_shape_baseline.json;命中件 sys.exit(1) 穿门,退出码语义不变)
  PYTHONIOENCODING=utf-8 uv run python etl/gate/main.py --only shape || { echo "[pre-push] etl 形制闸未过,push 已拦。"; exit 1; }
  # 类型闸(2026-08-31 批I 清零后上线):pyrefly 全仓零错,新增类型错拦 push(挂牌=逐行带理由)
  PYTHONIOENCODING=utf-8 uv run --group dev pyrefly check etl || { echo "[pre-push] pyrefly 类型闸未过,push 已拦。"; exit 1; }
  echo "[pre-push] etl 闸过。"
fi
# --diff-filter=d 排掉本批**删除**的路径(2026-08-24 实撞:域内文件批量改成小写后,
# diff 会同时列出旧大写名与新小写名;Windows 文件系统不分大小写,下面的 [ -f ] 对早已
# 不存在的 AccountMenu.tsx 照样成立 → 拿旧名送进 eslint,命中「文件名必须小写」当场拦 push。
# 只查这次推上去后仍然存在的文件才是这道闸的本意。)
changed=$(git diff --name-only --diff-filter=d "$upstream"..HEAD 2>/dev/null | grep -E '^cms/.*\.(ts|tsx|mjs)$')
[ -z "$changed" ] && exit 0

files=""
for f in $changed; do
  [ -f "$f" ] && files="$files ${f#cms/}"
done
[ -z "$files" ] && exit 0

cd cms || exit 1
echo "[pre-push] eslint $(echo $files | wc -w) 个改动文件…"
# 2026-08-22 手写棒轮退役:warn 清单全部升 error,存量在 cms/eslint-suppressions.json 基线里
# (ESLint 核心 bulk suppressions,v9.24+)。新违规直接拦;修掉存量后基线收紧跑 `npm run lint:prune`。
# --pass-on-unpruned-suppressions:这里只 lint 改动文件,没被 lint 的文件的基线条目不算「没用上」。
# 2026-08-29 实撞:换装大批一次推 700+ 文件,逐个拼参撞 Windows 命令行长度上限,
# eslint 起都没起来就被当成「有 error」拦下 —— 改 xargs 分 50 一块喂,任意规模不炸;
# xargs 聚合退出码(任一块非零则非零),拦截语义不变。
# 大批量档(2026-08-29 二撞:15 块 = 15 次 eslint 冷启动,比全量还慢):
# 超过 200 个文件直接整 src 一次冷启动查完,拦截语义只紧不松(查得更多)。
code=0
n=$(echo $files | wc -w)
if [ "$n" -gt 200 ]; then
  echo "[pre-push] 改动 $n 个文件,走全量档(单次冷启动)…"
  npx eslint src --quiet --pass-on-unpruned-suppressions || code=$?
else
  printf '%s
' $files | xargs -n 50 npx eslint --quiet --pass-on-unpruned-suppressions || code=$?
fi
if [ $code -ne 0 ]; then
  echo "[pre-push] eslint 有 error,push 已拦 —— 修完再推(禁 --no-verify)。"
  exit $code
fi
echo "[pre-push] eslint 过闸。"

# 裸构建闸(Frank 2026-08-23 拍板「加闸门,下次不要发烧」):复现 Render 构建容器 ——
# 它不注入运行时密钥,而 Next 构建期会收集 generateSitemaps 等页面数据,凡是这条路上
# 摸 Payload/库又没兜底的代码,本地带 .env 的 build 全绿、Render 当场红(seo 立域实撞,
# 修复=分片壳 getDb 裹回兜底)。手法:空串环境变量压过 .env(dotenv 不覆盖已存在变量,
# 空串也算存在),等价于构建容器没密钥;约 30-45s,只有真要 push 时才花。
echo "[pre-push] 裸构建(无密钥,复现 Render 构建容器)…"
PAYLOAD_SECRET= DATABASE_URI= npm run build >/tmp/prepush-bare-build.log 2>&1
code=$?
if [ $code -ne 0 ]; then
  echo "[pre-push] 裸构建失败 —— 构建期有代码在无密钥环境下抛错,Render 上必红。"
  echo "[pre-push] 日志:/tmp/prepush-bare-build.log(尾部如下);修法参考 jobs/sitemap.ts 头注。"
  tail -30 /tmp/prepush-bare-build.log
  exit $code
fi
echo "[pre-push] 裸构建过闸。"
