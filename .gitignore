# GeoNames 源(可从 download.geonames.org/export/zip/CA.zip 重下;衍生表 fsa/fsa-districts.json 跟踪)
/data/raw/fsa/CA.txt
# ESDC 工资源 CSV(可从 open.canada.ca 重下;衍生表 wages/wages.json 跟踪)
/data/raw/wages/*.csv
# ESDC LMIA 季度源 + 聚合表(16MB+,可重建;E6-02)
/data/raw/lmia/
# StatCan JVWS 全表 CSV zip 源(~97MB,可从 WDS API 重下;衍生表 jvws/jvws-vacancies.json 跟踪;E14-01)
/data/raw/jvws/*.zip
